{
    "datasets": [
        {
            "name": "ideology_news",
            "filepath": "./data/ideology_news-full.csv",
            "csv-sep": ",",
            "id_col": "ID",
            "text_col": "content",
            "label_col": "bias_text",
            "labels": ["left", "right", "center"],
            "columns-for-independant-variables": ["topic", "source"]
        }
    ],
    "parameters": {
        "N_annotated": [500, 1000, 1500, 2000],
        "splits_ratio": [
            [80, 10, 10],
            [70, 15, 15],
            [50, 10, 40]
        ],
        "sampling_method": [
            {
                "balance": "random"
            },
            {
                "balance": 0.25
            },
            {
                "balance": 0.5
            },
            {
                "balance": 0.75
            },
            {
                "balance": "random",
                "stratified": "year"
            },
            {
                "balance": 0.25,
                "stratified": "year"
            },
            {
                "balance": 0.5,
                "stratified": "year"
            },
            {
                "balance": 0.75,
                "stratified": "year"
            }
        ],
        "model_name": ["google-bert/bert-base-uncased"],
        "learning_rate": [0.0005, 0.0001, 1e-05, 2e-05, 5e-05],
        "weight_decay": [0.0, 0.01, 0.03, 0.1],
        "batch_size": [8, 16, 32],
        "seed": [42]
    }
}
